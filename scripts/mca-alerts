#!/bin/bash
# Master switch for alert sounds (laptop speaker and phone dashboard).
# Usage: mca-alerts on|off|status      (on/off need root: sudo mca-alerts off)
# State file: /etc/mca-alerts-master ("on" or "off"; a missing file means on).
# Note: mca-hw-watch publishes this state to Netdata (mca.alerts_on) for the phone dashboard.
# KNOWN GAP: the current mca-alert does not read this file, so "off" does not mute the laptop speaker.
# See docs/08-monitoring-logging.md.
F=/etc/mca-alerts-master
case "$1" in
  on|off) echo "$1" > "$F" && chmod 644 "$F" && logger -t mca-alert -p user.notice "[master] alerts $1" && echo "Alerts: $1";;
  status|"") if [ "$(cat "$F" 2>/dev/null)" = off ]; then echo "Alerts: off"; else echo "Alerts: on"; fi;;
  *) echo "Usage: $0 on|off|status" >&2; exit 1;;
esac
