# Example for /etc/default/mca-alert (real file: root:root, mode 600).
# Used by mca-alert and mca-hw-watch. Restart after changes: sudo systemctl restart mca-hw-watch
VOLUME=70                  # speaker volume in % (amixer -M, perceptual scale)
WIFI_ALERT_LEVEL=info      # level used when the router is unreachable for 90 s (info = log only)
TEMP_CRIT=92               # CPU temperature (C) for a critical alert, 30 s in a row
REMIND_ON_BATTERY=900      # power outage: reminder every X seconds, sound from the first reminder on (daytime)
QUIET_START=23             # quiet hours start (hour): no sound at all from the laptop
QUIET_END=6                # quiet hours end (hour, exclusive)
POWER_GRACE=60             # power-loss alert only after X seconds without mains power
NTFY_URL=https://ntfy.sh
# SECRET: whoever knows the topic can read the messages and send new ones. Use a long random name.
NTFY_TOPIC=<NTFY_TOPIC_SECRET>
# Dead man's switch (healthchecks.io). SECRET: the ping URL contains a unique ID.
HC_PING_URL=<HEALTHCHECKS_PING_URL_SECRET>
# Router address for the Wi-Fi check (default in the script is the documentation address 192.0.2.1).
#WIFI_GATEWAY=<ROUTER_IP>
